{
  "family": "forgenta",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::541974874550:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "541974874550.dkr.ecr.ap-northeast-2.amazonaws.com/forgenta-api:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "OLLAMA_HOST",  "value": "http://llm-dev.intuaos.com:11434" },
        { "name": "OLLAMA_MODEL", "value": "ibm/granite4.1:8b" },
        { "name": "EMBED_MODEL",  "value": "ibm/granite4.1:8b" },
        { "name": "FRONTEND_URL", "value": "http://forgenta.intuaos.com" },
        { "name": "API_BASE_URL", "value": "http://forgenta.intuaos.com" }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:541974874550:parameter/forgenta/jwt-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/forgenta",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    },
    {
      "name": "frontend",
      "image": "541974874550.dkr.ecr.ap-northeast-2.amazonaws.com/forgenta-frontend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "API_HOST", "value": "localhost" }
      ],
      "dependsOn": [
        { "containerName": "api", "condition": "START" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/forgenta",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
